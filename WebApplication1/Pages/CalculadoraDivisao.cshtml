@page
@model WebApplication1.Pages.CalculadoraDivisaoModel
@{
    ViewData["Title"] = "Calculadora de Divisão Segura";
}

<h2>Calculadora de Divisão Segura</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="Numero1">Primeiro Número:</label>
        <input asp-for="Numero1" class="form-control" type="number" />
    </div>
    <div class="mb-3">
        <label asp-for="Numero2">Segundo Número:</label>
        <input asp-for="Numero2" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Dividir</button>
</form>

@if (Model.Resultado.HasValue)
{
    <div class="alert alert-success mt-3">Resultado: @Model.Resultado</div>
}

@if (!string.IsNullOrEmpty(Model.MensagemDeErro))
{
    <div class="alert alert-danger mt-3">@Model.MensagemDeErro</div>
}
