@page
@model WebApplication1.Pages.VerificadorDeAcessoModel
@{
    ViewData["Title"] = "Verificador de Acesso";
}

<h2>Verificador de Acesso</h2>

<form method="post">
    <div class="mb-3">
        <label asp-for="Nome">Nome:</label>
        <input asp-for="Nome" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Idade">Idade:</label>
        <input asp-for="Idade" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary">Verificar</button>
</form>

@if (!string.IsNullOrEmpty(Model.MensagemDeRetorno))
{
    <div class="alert alert-info mt-3">@Model.MensagemDeRetorno</div>
}
